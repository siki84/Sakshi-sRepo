# Required for live AI research (Claude API with web search enabled for your org).
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-sonnet-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# Where the SQLite database lives (default: ./data).
# DATA_DIR=./data

# Contact string sent to Nominatim in the User-Agent (their usage policy asks for one).
# NOMINATIM_CONTACT=you@example.com

# Development / testing switches. 1 = use bundled fixtures instead of live calls.
# MOCK_AI=1          # Claude calls return fixture JSON (still schema-validated)
# MOCK_EXTERNAL=1    # Open-Meteo + Nominatim return fixture data
